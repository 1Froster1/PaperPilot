# 复制本文件为 .env 并填入真实配置。.env 已被 .gitignore 忽略，请勿提交。

# Python Agent HTTP service
AGENT_HOST=127.0.0.1
AGENT_PORT=8001

# 大模型服务（按 llm_service 中实际实现的 provider 填写）
LLM_MODEL_ID=your-model-id
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.deepseek.com

# GROBID（PDF 结构化解析）
GROBID_URL=http://127.0.0.1:8070/api/processFulltextDocument
GROBID_TIMEOUT_SECONDS=180

# 本地 Qdrant 向量数据库
QDRANT_URL=http://127.0.0.1:6335
QDRANT_COLLECTION=paperpilot_chunks_dense_v1
QDRANT_VECTOR_SIZE=1024
QDRANT_DISTANCE=cosine
QDRANT_TIMEOUT=30
QDRANT_API_KEY=

# Embedding 模型（dashscope / openai 等，见 embedding_service.py）
EMBED_MODEL_TYPE=dashscope
EMBED_MODEL_NAME=text-embedding-v3
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_API_KEY=your-api-key

# OpenAlex 学术检索 MCP
OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_API_KEY=
OPENALEX_MAILTO=
OPENALEX_TIMEOUT=15

# Tavily 通用网络检索 MCP
TAVILY_API_URL=https://api.tavily.com/search
TAVILY_API_KEY=your-tavily-api-key
TAVILY_TIMEOUT=15
