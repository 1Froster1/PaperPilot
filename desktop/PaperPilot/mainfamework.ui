  <property name="styleSheet">
   <string notr="true">QWidget#mainfamework { background: #f8fbff; }
QFrame#sidebar { background: #f4f8ff; border-right: 1px solid #e2e8f0; }
QLabel#brandMark { color: #216df3; font-size: 34px; font-weight: 700; }
QLabel#brandTitle { color: #0f1c4e; font-size: 25px; font-weight: 700; }
QLabel#brandSlogan, QLabel#sectionTitle, QLabel#taskHint, QLabel#taskHint2, QLabel#contentHint { color: #71809d; }
QPushButton[navButton=&quot;true&quot;] { border: none; border-radius: 9px; color: #26385e; font-size: 16px; font-weight: 600; min-height: 44px; padding-left: 16px; text-align: left; }
QPushButton[navButton=&quot;true&quot;]:hover { background: #e6f0ff; }
QPushButton[navButton=&quot;true&quot;]:checked { background: #dbeafe; color: #1769ed; }
QPushButton#importButton { background: #216df3; border: none; border-radius: 9px; color: white; font-size: 16px; font-weight: 600; min-height: 48px; }
QPushButton#importButton:hover { background: #155bd2; }
QFrame#taskCard { background: white; border: 1px solid #e3eaf5; border-radius: 10px; }
QLabel#pdfBadge { background: #ffe5e7; border-radius: 5px; color: #ed3c50; font-weight: 700; padding: 6px; }
QLabel#taskTitle { color: #28385b; font-weight: 600; }
QProgressBar { background: #eaf0fa; border: none; border-radius: 4px; height: 8px; text-align: center; }
QProgressBar::chunk { background: #216df3; border-radius: 4px; }
QPushButton#pushButton_exit { background: transparent; border: none; border-radius: 9px; color: #52627f; font-size: 15px; min-height: 40px; padding-left: 15px; text-align: left; }
QPushButton#pushButton_exit:hover { background: #e6f0ff; color: #1769ed; }
QFrame#contentPanel { background: white; }
QLabel#contentTitle { color: #14234a; font-size: 28px; font-weight: 700; }
QLabel#contentPlaceholder { background: #f8fbff; border: 1px dashed #bfd2ef; border-radius: 14px; color: #5c6d8d; font-size: 17px; }</string>
